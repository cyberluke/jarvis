<Project Sdk="Microsoft.NET.Sdk">

  <!-- Toastovač Everywhere Host: native Windows companion for the Jarvis
       runtime. WinUI 3 on top of the Windows App SDK; talks to the Python
       broker over the current-user named pipe only (no TCP). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Per-Monitor V2 DPI awareness so overlays span the true physical
         screen width on 4K/high-DPI displays (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <!-- System.Windows.Automation (UIA) ships in the WPF framework; the
         generic Microsoft.WindowsDesktop.App does not include it. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

</Project>
