<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- QLED-safe: almost-black everywhere, no white flash on launch. -->
    <style name="Theme.Toastovac" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/void_bg</item>
        <item name="android:statusBarColor">@color/void_bg</item>
        <item name="android:navigationBarColor">@color/void_bg</item>
    </style>
</resources>