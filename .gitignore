.DS_Store
.env/
.venv/
__pycache__/
.pytest_cache/
tests/performance/reports/
.mamba_env/
.micromamba/
.claude/*
!.claude/launch.json
!.claude/skills/

# Local agent persona / skill config (not part of the project)
.agents/
AGENTS.md

# Release artifacts
release_output.log
node_modules/

# PyInstaller build artifacts
build/
dist/
*.spec.backup
qt.conf

# Auto-generated version file (created at build time)
src/jarvis/_version.py
.reasonix/

# Local deployment state for Home Assistant ops scripts (may contain IPs)
ops/home-assistant/local-state.json

# Regenerated runtime caches (OpenVINO NPU compiled binaries, profiler data)
.cache/
infra/openvino-npu/cache/
infra/openvino-npu/cache-verification/npu_profiling_data
infra/openvino-npu/models/Qwen3-Embedding-0.6B-int4-cw-ov/1/openvino_model.bin
infra/openvino-npu/models/Qwen3-Reranker-0.6B-int8-ov/1/openvino_model.bin

# Voice PE smoke two-channel WAV dumps (regenerated on every run)
pe_diag-channel-*.wav
probe-channel-*.wav

# OneOCR maintainer staging area (transient; recreated per preparation run)
tools/oneocr/.work/

# Third-party toolchain binaries (downloaded builds; regenerable, too large
# for git — ffplay/ffmpeg/ffprobe alone exceed GitHub's 100 MB file limit)
tools/ffmpeg/
tools/intel-video/
tools/qsvenc/

# Rust build artifacts (regenerated by cargo build)
tools/live_hdr/native_engine/target/

# .NET build outputs (host binaries deploy from build\everywhere_host)
native/Toastovac.Everywhere.Host/bin/
native/Toastovac.Everywhere.Host/obj/
